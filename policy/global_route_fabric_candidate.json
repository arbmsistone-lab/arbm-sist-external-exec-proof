{
  "schema_version": 2,
  "status": "candidate_not_constitutional",
  "invariants": {
    "NO_MANDATORY_PROVIDER": true,
    "OPEN_ADAPTER_PROTOCOL": true,
    "DYNAMIC_ROUTE_DISCOVERY": true,
    "SURPLUS_ROUTE_CAPACITY": true
  },
  "provider_neutral": true,
  "hardcoded_provider_allowlist": false,
  "provider_names_non_semantic": true,
  "adapter_protocol": {
    "version": "arbm-route-adapter/v1",
    "lifecycle": [
      "DISCOVER",
      "AUTHENTICATE",
      "QUALIFY",
      "LEASE",
      "EXECUTE",
      "OBSERVE",
      "CHECKPOINT",
      "VERIFY",
      "RELEASE"
    ],
    "registration": "dynamic",
    "future_adapters_without_mission_kernel_change": true
  },
  "route_classes": [
    "native_runtime",
    "customer_runtime",
    "cloud_runner",
    "ci_runner",
    "container",
    "vm_bare_metal",
    "serverless_edge",
    "browser_node",
    "official_api_connector",
    "remote_desktop_node",
    "state_backend",
    "evidence_backend"
  ],
  "required_route_properties": [
    "legitimate_authority",
    "capability_match",
    "health_pass",
    "fresh_witness",
    "dependency_graph",
    "cost_policy_pass",
    "security_policy_pass"
  ],
  "critical_route_properties": [
    "takeover_witness",
    "independent_failure_domain"
  ],
  "resilience": {
    "target_failure_domain_tolerance": 2,
    "required_spare_routes_after_tolerated_failures": 1,
    "shared_critical_dependency_collapses_routes": true
  },
  "routing_objectives": [
    "safety",
    "failure_domain_diversity",
    "spare_capacity",
    "availability",
    "latency",
    "cost_policy"
  ],
  "unavailable_route_behavior": "remove_from_eligible_quorum",
  "rejoin_behavior": "requalify_before_counting",
  "unknown_route_behavior": "not_counted_until_qualified"
}
