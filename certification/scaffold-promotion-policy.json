{
  "schema": "arbm-scaffold-promotion-policy-v1",
  "failClosed": true,
  "comparabilityRequired": [
    "sameModel",
    "sameTaskSet",
    "sameBudget",
    "sameHarness",
    "sameVerifier"
  ],
  "reproducibleGain": {
    "minDistinctTasks": 3,
    "minRepetitionsPerTask": 3,
    "minAbsoluteMeanGain": 0.05,
    "minImprovedTaskFraction": 0.6666666,
    "maxExceptionRateIncrease": 0.0
  },
  "failureModeElimination": {
    "requiredModes": [
      "premature_completion",
      "missing_required_output",
      "no_final_verification"
    ],
    "candidateAllowedCountPerMode": 0,
    "maxMeanRewardRegression": 0.0,
    "maxExceptionRateIncrease": 0.0
  },
  "regression": {
    "allExistingGatesMustPass": true,
    "allowNewP0": 0,
    "allowNewP1": 0,
    "allowNewP2": 0,
    "maxRegressedTaskFraction": 0.0
  },
  "promotionRule": "GAIN_REPRODUCIBLE_OR_FAILURE_MODES_ELIMINATED_AND_ZERO_REGRESSION"
}
